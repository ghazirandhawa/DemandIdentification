# Copy to ".env" in this directory (repository root).
# Values load automatically when SEC_DATA is imported (see data_sources/SEC_DATA/).
#
# SEC programmatic access policy:
# https://www.sec.gov/os/webmaster-faq#developers

SEC_USER_AGENT=YourOrganizationName your.email@example.com

# Optional: max HTTP requests per second to sec.gov (integer 1–10, default 9).
# SEC states a maximum of 10/sec; parallel bulk sync shares one process-wide limiter.
# SEC_MAX_RPS=9

# --- Bronze pipeline (pipeline_sec_to_bronze.py) ---
# LLM provider: ``openai`` or ``gemini``. If omitted: only GEMINI_API_KEY -> Gemini; only
# OPENAI_API_KEY -> OpenAI; both keys set -> Openai unless you set BRONZE_LLM_PROVIDER=gemini.
# BRONZE_LLM_PROVIDER=gemini
# OPENAI_API_KEY=
# Chat Completions model id from OpenAI (lowercase, e.g. gpt-4.1-mini, gpt-4o-mini, gpt-4o).
# Omit OPENAI_MODEL to use the code default. Display names like ``GPT-5.4`` are not valid API ids.
# OPENAI_MODEL=gpt-4.1-mini
#
# Google AI Studio / Gemini (when BRONZE_LLM_PROVIDER=gemini).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# When unset or truthy (1/yes/on): silver scoring asks Gemini for JSON (response_mime_type).
# Set to 0/false/no/off if your endpoint rejects that option.
# GEMINI_RESPONSE_JSON=1
# When unset or truthy: if the first scoring response is not valid JSON, one repair call is made.
# Set to 0/false/no/off to skip the extra call (saves latency/cost; rows may fail more often).
# GEMINI_JSON_REPAIR=1
#
# Bronze table location (Postgres schemas: bronze / silver / gold). Defaults: bronze + sec_filings.
# BRONZE_SCHEMA=bronze
# BRONZE_TABLE=sec_filings

# Bronze batching (pipeline_sec_to_bronze.py): use --offset N --limit M for the next slice;
# --llm-max-consecutive-failures N stops after N+1 consecutive LLM API failures and still writes
# CSV + Postgres for rows collected.

# Postgres or CockroachDB connection (psycopg2). Example (replace password):
# DATABASE_URL=postgresql://user:YOUR_PASSWORD@host:26257/defaultdb?sslmode=verify-full

# --- Silver SEC opportunities (pipeline_silver_sec_opportunities.py) ---
# Defaults match Demand Intelligence / gold-style naming. Override only if your DB uses different ids.
# SILVER_SCHEMA=silver
# SILVER_SEC_OPPORTUNITIES_TABLE=SEC_filings_opportunities
# SILVER_SEC_INSIGHTS_TABLE=SEC_filings_opportunities_insights
# Optional: path basename for ICP docx if not DataPilot_ICP_v3.docx
# DATAPILOT_ICP_DOCX=DataPilot_ICP_v3.docx

# Place under datapilot_docs/: project_scope.txt; DataPilot_ICP_v3.docx; Data Pilot Sales Deck Complete.pptx
#
# Silver Gemini context sizing (pipeline_silver_sec_*.py): use --max-datapilot-total (default 120000)
# or legacy --max-context-chars to cap each of scope/ICP/deck sections equally.
# Silver pipelines: --workers N (default 4), --no-progress. Recreate: opportunities script
# --recreate-silver-tables drops both silver SEC tables; insights script same flag drops only
# SEC_filings_opportunities_insights. Neither touches bronze.
